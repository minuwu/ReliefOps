# Copy to backend/.env and fill in. Never commit backend/.env.

# AI document extraction (Galib, app/services/ai_extraction.py). All free tiers, no card needed.
GEMINI_API_KEY=your-gemini-key        # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=your-openrouter-key  # https://openrouter.ai/keys (backup vision model)
GROQ_API_KEY=your-groq-key            # https://console.groq.com/keys (case assistant answers)

# Local OCR used to verify AI evidence. Leave empty on Linux/Docker if tesseract is on PATH.
TESSERACT_CMD=
TESSDATA_PREFIX=
