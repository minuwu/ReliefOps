#!/bin/sh
# Git Pre-Push Hook: Auto fetch, check for remote updates (origin/main and upstream),
# pull & merge if needed before pushing.

remote="$1"
url="$2"

# Avoid recursive loop if hook re-invokes push
if [ "$PRE_PUSH_RUNNING" = "1" ]; then
    exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
    exit 0
fi

echo "=========================================================="
echo " [pre-push hook] Syncing repo before push: branch '$branch'..."
echo "=========================================================="

# Refuse to auto-merge over uncommitted changes: a merge would mix them in or fail halfway.
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
    echo " [pre-push hook] ERROR: uncommitted changes in working tree."
    echo " Commit or stash them, then push again."
    exit 1
fi

# Never auto-merge into main; main only moves via pull requests.
if [ "$branch" = "main" ]; then
    echo " [pre-push hook] ERROR: direct push to 'main' is blocked. Open a PR from a '<name>/<topic>' branch."
    exit 1
fi

# Fetch latest from remote
git fetch "$remote" 2>/dev/null

merged_anything=0

# 1. Check if upstream branch on remote has changes
if git rev-parse --verify "$remote/$branch" >/dev/null 2>&1; then
    upstream_behind=$(git rev-list --count HEAD.."$remote/$branch" 2>/dev/null || echo 0)
    if [ "$upstream_behind" -gt 0 ]; then
        echo " [pre-push hook] $remote/$branch has $upstream_behind new commit(s). Merging..."
        if ! git merge "$remote/$branch" --no-edit; then
            echo " [pre-push hook] ERROR: Merge conflict when pulling $remote/$branch."
            echo " Please resolve conflicts before pushing."
            exit 1
        fi
        merged_anything=1
    fi
fi

# 2. If working on a feature branch, check if origin/main has updates
if [ "$branch" != "main" ] && git rev-parse --verify "$remote/main" >/dev/null 2>&1; then
    main_behind=$(git rev-list --count HEAD.."$remote/main" 2>/dev/null || echo 0)
    if [ "$main_behind" -gt 0 ]; then
        echo " [pre-push hook] $remote/main has $main_behind new commit(s). Merging into $branch..."
        if ! git merge "$remote/main" --no-edit; then
            echo " [pre-push hook] ERROR: Merge conflict when pulling $remote/main."
            echo " Please resolve conflicts before pushing."
            exit 1
        fi
        merged_anything=1
    fi
fi

if [ "$merged_anything" -eq 1 ]; then
    echo " [pre-push hook] New changes merged into $branch successfully."
    echo " [pre-push hook] Updating push target to include new merge commit..."
    export PRE_PUSH_RUNNING=1
    if git push "$remote" "$branch"; then
        echo " [pre-push hook] Push completed with merged changes."
        echo " [pre-push hook] The 'failed to push' line below is expected: the original, stale push is cancelled."
    else
        echo " [pre-push hook] ERROR: re-push failed. Fix and run git push again."
    fi
    exit 1  # Abort the original (stale) push; the re-push above already delivered the merge commit.
fi

echo " [pre-push hook] Branch '$branch' is fully synced with $remote. Proceeding with push."
exit 0
