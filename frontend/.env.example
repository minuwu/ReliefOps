# API base URL.
#   Local FastAPI backend:      http://localhost:8000
#   Prism contract mock (:4010): http://127.0.0.1:4010
#     start it from the repo root:
#     npx -y @stoplight/prism-cli@5.14.2 mock docs/openapi.yaml -p 4010
VITE_API_URL=http://localhost:8000

# "true"  = built-in in-memory demo store (no server needed; login ignores the password)
# "false" = call VITE_API_URL (live backend or Prism)
VITE_USE_MOCK=true
