# Copy to deploy/azure-vm/.env.prod (gitignored) and fill in. deploy.sh uploads it to the VM.
# Secrets come privately: the two database URLs from Anim (backend/.env.deploy), the AI keys from Galib.

# Supabase session pooler (port 5432, not 6543), with ?sslmode=require. See docs/DEPLOY-FREE.md.
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

APP_ENV=prod
CORS_ORIGINS=https://reliefops.web.app,https://reliefops.firebaseapp.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5199,http://127.0.0.1:5199
FRONTEND_BASE_URL=https://reliefops.web.app
EMAIL_MODE=console
AI_MODE=live
# Galib, XREQ-007 A6: extraction stops itself at 17 s and chat at 15 s; free tiers throttle bursts.
AI_TIMEOUT_SECONDS=20
AI_MAX_CONCURRENT=2
SESSION_HOURS=8
LOG_LEVEL=INFO
